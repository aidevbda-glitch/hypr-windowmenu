#!/usr/bin/env python3
"""
hypr-windowmenu - Context menu for Hyprland window management
Shows a GTK context menu at cursor position with window operations.
"""

import gi
import json
import os
import subprocess
import sys
import argparse

gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gtk, Gdk, GLib, Gio, GtkLayerShell


def run_hyprctl(*args) -> str:
    """Run hyprctl and return stdout."""
    cmd = ["hyprctl", "-q"] + list(args)
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        return result.stdout.strip()
    except Exception as e:
        print(f"hyprctl error: {e}", file=sys.stderr)
        return ""


def run_hyprctl_json(*args) -> dict | list:
    """Run hyprctl with JSON output and parse."""
    cmd = ["hyprctl", "-j"] + list(args)
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        return json.loads(result.stdout)
    except Exception as e:
        print(f"hyprctl json error: {e}", file=sys.stderr)
        return {}


class HyprWindowMenu(Gtk.Window):
    def __init__(self, config_path: str | None = None, window_address: str | None = None):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.window_address = window_address
        self.window_info = None
        self.config = self.load_config(config_path)
        
        # Set up layer shell for proper Wayland positioning
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
        
        # Make it look like a context menu
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_default_size(200, 1)
        
        # Create list box as menu
        self.list_box = Gtk.ListBox()
        self.list_box.set_selection_mode(Gtk.SelectionMode.NONE)
        self.list_box.set_name("hypr-windowmenu-list")
        
        # Add CSS styling
        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(b"""
            #hypr-windowmenu-list {
                background-color: #2e3440;
                border-radius: 6px;
                border: 1px solid #4c566a;
            }
            #hypr-windowmenu-list row {
                padding: 8px 16px;
                color: #d8dee9;
            }
            #hypr-windowmenu-list row:hover {
                background-color: #4c566a;
            }
            #hypr-windowmenu-list row:selected {
                background-color: #5e81ac;
            }
            #hypr-windowmenu-list separator {
                background-color: #4c566a;
                min-height: 1px;
                margin: 4px 12px;
            }
            .menu-title {
                font-weight: bold;
                color: #eceff4;
                padding: 8px 16px 4px 16px;
            }
            .menu-subtitle {
                color: #81a1c1;
                font-size: smaller;
                padding: 0 16px 8px 16px;
            }
            .menu-shortcut {
                color: #81a1c1;
                font-size: smaller;
                margin-left: 12px;
            }
        """)
        screen = Gdk.Screen.get_default()
        style_context = self.list_box.get_style_context()
        style_context.add_provider_for_screen(screen, css_provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        
        # Scrolled window for content
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_max_content_height(600)
        scrolled.set_propagate_natural_height(True)
        scrolled.add(self.list_box)
        
        self.add(scrolled)
        
        # Detect target window
        if not self.window_address:
            self.window_info = self.find_window_under_cursor()
            if self.window_info:
                self.window_address = self.window_info.get("address")
        else:
            self.window_info = self.get_window_by_address(self.window_address)
        
        self.build_menu()
        
        # Close on Escape and focus-out
        self.connect("key-press-event", self.on_key_press)
        self.connect("focus-out-event", self.on_focus_out)
        self.connect("button-press-event", self.on_button_press)
    
