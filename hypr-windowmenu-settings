class SettingsWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="hypr-windowmenu Settings")
        self.set_default_size(700, 550)
        self.set_border_width(12)
        
        self.config_path = self.find_config_path()
        self.config = self.load_config()
        self.modified = False
        
        # Header bar
        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title("hypr-windowmenu Settings")
        
        save_btn = Gtk.Button(label="Save")
        save_btn.get_style_context().add_class("suggested-action")
        save_btn.connect("clicked", self.on_save)
        header.pack_end(save_btn)
        
        defaults_btn = Gtk.Button(label="Reset to Defaults")
        defaults_btn.connect("clicked", self.on_reset_defaults)
        header.pack_start(defaults_btn)
        
        self.set_titlebar(header)
        
        # Main layout
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.add(vbox)
        
        # Info bar
        info = Gtk.Label()
        info.set_markup(
            '<small><b>Config:</b> ' + GLib.markup_escape_text(self.config_path) + 
            '  |  <b>Trigger key:</b> Set in ~/.config/hypr/hyprland.conf</small>'
        )
        info.set_halign(Gtk.Align.START)
        vbox.pack_start(info, False, False, 0)
        
        # Notebook (tabs)
        notebook = Gtk.Notebook()
        vbox.pack_start(notebook, True, True, 0)
        
        # Tab 1: General
        general_tab = self.build_general_tab()
        notebook.append_page(general_tab, Gtk.Label(label="General"))
        
        # Tab 2: Actions
        actions_tab = self.build_actions_tab()
        notebook.append_page(actions_tab, Gtk.Label(label="Menu Actions"))
        
        # Tab 3: Help
        help_tab = self.build_help_tab()
        notebook.append_page(help_tab, Gtk.Label(label="Help"))
        
        # Status bar
        self.status_label = Gtk.Label(label="Ready")
        self.status_label.set_halign(Gtk.Align.START)
        vbox.pack_start(self.status_label, False, False, 0)
        
        self.connect("delete-event", self.on_close)
    
    def find_config_path(self) -> str:
        xdg_config = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
        user_path = os.path.join(xdg_config, "hypr-windowmenu", "config.json")
        if os.path.exists(user_path):
            return user_path
        # Default system path
        return "/usr/share/hypr-windowmenu/config.json"
    
    def load_config(self) -> dict:
        if os.path.exists(self.config_path):
            try:
                with open(self.config_path, "r") as f:
                    return json.load(f)
            except Exception as e:
                print(f"Failed to load config: {e}", file=sys.stderr)
        return copy.deepcopy(DEFAULT_CONFIG)
    
    def build_general_tab(self) -> Gtk.Widget:
        grid = Gtk.Grid()
        grid.set_column_spacing(12)
        grid.set_row_spacing(8)
        grid.set_margin_top(12)
        grid.set_margin_bottom(12)
        grid.set_margin_start(12)
        grid.set_margin_end(12)
        
        row = 0
        
        # Show title
        label = Gtk.Label(label="Show window title in menu:")
        label.set_halign(Gtk.Align.END)
        grid.attach(label, 0, row, 1, 1)
        
        self.show_title_switch = Gtk.Switch()
        self.show_title_switch.set_active(self.config["menu"].get("show_title", True))
        self.show_title_switch.connect("notify::active", self.on_modified)
        grid.attach(self.show_title_switch, 1, row, 1, 1)
        row += 1
        
        # Title max length
        label = Gtk.Label(label="Title max length:")
        label.set_halign(Gtk.Align.END)
        grid.attach(label, 0, row, 1, 1)
        
        self.title_len_spin = Gtk.SpinButton()
        self.title_len_spin.set_range(10, 100)
        self.title_len_spin.set_increments(5, 10)
        self.title_len_spin.set_value(self.config["menu"].get("title_max_length", 40))
        self.title_len_spin.connect("value-changed", self.on_modified)
        grid.attach(self.title_len_spin, 1, row, 1, 1)
        row += 1
        
        # Separator hint
        hint = Gtk.Label()
        hint.set_markup(
            '<small><span foreground="#81a1c1">'
            'Changes apply immediately after saving. Restart hypr-windowmenu to see changes.'
            '</span></small>'
        )
        hint.set_halign(Gtk.Align.START)
        grid.attach(hint, 0, row, 2, 1)
        
        return grid
    
    def build_actions_tab(self) -> Gtk.Widget:
        hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        
        # Left: action list
        left_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        left_box.set_size_request(250, -1)
        
        list_label = Gtk.Label(label="Menu Items")
        list_label.set_halign(Gtk.Align.START)
        left_box.pack_start(list_label, False, False, 0)
        
        # Scrolled list
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_vexpand(True)
        
        self.action_store = Gtk.ListStore(str, str)  # display, type
        self.action_tree = Gtk.TreeView(model=self.action_store)
        self.action_tree.set_headers_visible(False)
        
        renderer = Gtk.CellRendererText()
        column = Gtk.TreeViewColumn("Action", renderer, text=0)
        self.action_tree.append_column(column)
        
        self.action_tree.connect("cursor-changed", self.on_action_selected)
        scroller.add(self.action_tree)
        left_box.pack_start(scroller, True, True, 0)
        
        # List buttons
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        
        add_btn = Gtk.Button(label="+")
        add_btn.connect("clicked", self.on_add_action)
        btn_box.pack_start(add_btn, True, True, 0)
        
        remove_btn = Gtk.Button(label="−")
        remove_btn.connect("clicked", self.on_remove_action)
        btn_box.pack_start(remove_btn, True, True, 0)
        
        up_btn = Gtk.Button(label="↑")
        up_btn.connect("clicked", self.on_move_up)
        btn_box.pack_start(up_btn, True, True, 0)
        
        down_btn = Gtk.Button(label="↓")
        down_btn.connect("clicked", self.on_move_down)
        btn_box.pack_start(down_btn, True, True, 0)
        
        left_box.pack_start(btn_box, False, False, 0)
        
        hbox.pack_start(left_box, False, True, 0)
        
        # Right: action editor
        right_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        right_box.set_margin_start(8)
        
        editor_label = Gtk.Label(label="Action Editor")
        editor_label.set_halign(Gtk.Align.START)
        right_box.pack_start(editor_label, False, False, 0)
        
        # Editor form
        form_grid = Gtk.Grid()
        form_grid.set_column_spacing(8)
        form_grid.set_row_spacing(6)
        
        # Type
        form_grid.attach(Gtk.Label(label="Type:", halign=Gtk.Align.END), 0, 0, 1, 1)
        self.type_combo = Gtk.ComboBoxText()
        for t in ["action", "separator", "submenu_workspaces", "submenu_monitors"]:
            self.type_combo.append(t, t)
        self.type_combo.connect("changed", self.on_type_changed)
        form_grid.attach(self.type_combo, 1, 0, 1, 1)
        
        # Label
        form_grid.attach(Gtk.Label(label="Label:", halign=Gtk.Align.END), 0, 1, 1, 1)
        self.label_entry = Gtk.Entry()
        self.label_entry.connect("changed", self.on_field_changed)
        form_grid.attach(self.label_entry, 1, 1, 1, 1)
        
        # Icon
        form_grid.attach(Gtk.Label(label="Icon:", halign=Gtk.Align.END), 0, 2, 1, 1)
        self.icon_entry = Gtk.Entry()
        self.icon_entry.set_placeholder_text("e.g. window-close")
        self.icon_entry.connect("changed", self.on_field_changed)
        form_grid.attach(self.icon_entry, 1, 2, 1, 1)
        
        # Dispatcher
        form_grid.attach(Gtk.Label(label="Dispatcher:", halign=Gtk.Align.END), 0, 3, 1, 1)
        self.disp_entry = Gtk.Entry()
        self.disp_entry.set_placeholder_text("e.g. killactive, togglefloating")
        self.disp_entry.connect("changed", self.on_field_changed)
        form_grid.attach(self.disp_entry, 1, 3, 1, 1)
        
        # Arg
        form_grid.attach(Gtk.Label(label="Argument:", halign=Gtk.Align.END), 0, 4, 1, 1)
        self.arg_entry = Gtk.Entry()
        self.arg_entry.set_placeholder_text("e.g. 1, special:minimized")
        self.arg_entry.connect("changed", self.on_field_changed)
        form_grid.attach(self.arg_entry, 1, 4, 1, 1)
        
        # Shortcut
        form_grid.attach(Gtk.Label(label="Shortcut hint:", halign=Gtk.Align.END), 0, 5, 1, 1)
        self.shortcut_entry = Gtk.Entry()
        self.shortcut_entry.set_placeholder_text("e.g. Alt+F4, Super+M")
        self.shortcut_entry.connect("changed", self.on_field_changed)
        form_grid.attach(self.shortcut_entry, 1, 5, 1, 1)
        
        # Confirm
        form_grid.attach(Gtk.Label(label="Confirm:", halign=Gtk.Align.END), 0, 6, 1, 1)
        self.confirm_check = Gtk.CheckButton()
        self.confirm_check.connect("toggled", self.on_field_changed)
        form_grid.attach(self.confirm_check, 1, 6, 1, 1)
        
        right_box.pack_start(form_grid, False, False, 0)
        
        # Apply button for editor
        apply_btn = Gtk.Button(label="Apply Changes to Selected Item")
        apply_btn.connect("clicked", self.on_apply_editor)
        apply_btn.set_margin_top(8)
        right_box.pack_start(apply_btn, False, False, 0)
        
        # Hint
        hint = Gtk.Label()
        hint.set_markup(
            '<small><span foreground="#81a1c1">'
            'Select an item from the list to edit it. Click Apply to update.'
            '</span></small>'
        )
        hint.set_line_wrap(True)
        hint.set_halign(Gtk.Align.START)
        right_box.pack_start(hint, False, False, 0)
        
        hbox.pack_start(right_box, True, True, 0)
        
        # Populate list
        self.refresh_action_list()
        
        return hbox
    
    def build_help_tab(self) -> Gtk.Widget:
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        
        text = Gtk.TextView()
        text.set_editable(False)
        text.set_cursor_visible(False)
        text.set_wrap_mode(Gtk.WrapMode.WORD)
        text.set_margin_start(12)
        text.set_margin_end(12)
        text.set_margin_top(12)
        text.set_margin_bottom(12)
        
        help_text = """<b>Configuration</b>

The config file is JSON format stored at:
  ~/.config/hypr-windowmenu/config.json

<b>Changing the Trigger Key</b>

The trigger key is NOT set in this app — it's a Hyprland keybind.
Edit ~/.config/hypr/hyprland.conf:

  # Super + Right Click
  bind = $mainMod, mouse:273, exec, hypr-windowmenu

  # Alt + Right Click
  bind = ALT, mouse:273, exec, hypr-windowmenu

  # Ctrl + Right Click
  bind = CTRL, mouse:273, exec, hypr-windowmenu

  # Keyboard only
  bind = $mainMod, M, exec, hypr-windowmenu

<b>Action Types</b>

  action              — executes a Hyprland dispatcher
  separator           — horizontal divider line
  submenu_workspaces  — shows workspace selector popup
  submenu_monitors    — shows monitor selector popup

<b>Common Dispatchers</b>

  killactive, fullscreen, togglefloating, pin, centerwindow
  bringactivetotop, movetoworkspacesilent, exec

<b>Icons</b>

Use GTK icon names. Find icons with:
  gtk3-icon-browser

Or common names: window-close, view-fullscreen, window-minimize,
window-popout, view-pin, go-top, go-jump, video-display

<b>Tip</b>

After saving config, the next time you open the menu it will use
the new settings. No need to restart Hyprland."""
        
        buffer = text.get_buffer()
        buffer.set_text(help_text.replace("<b>", "").replace("</b>", ""))
        
        scroller.add(text)
        return scroller
    
    def refresh_action_list(self):
        self.action_store.clear()
        for action in self.config.get("actions", []):
            item_type = action.get("type", "action")
            if item_type == "separator":
                display = "— Separator —"
            else:
                display = action.get("label", "Untitled")
            self.action_store.append([display, item_type])
    
    def on_action_selected(self, treeview):
        selection = treeview.get_selection()
        model, treeiter = selection.get_selected()
        if treeiter is None:
            return
        
        index = model.get_path(treeiter).get_indices()[0]
        actions = self.config.get("actions", [])
        if index >= len(actions):
            return
        
        action = actions[index]
        item_type = action.get("type", "action")
        
        # Update editor fields (block signals temporarily)
        self.type_combo.set_active_id(item_type)
        self.label_entry.set_text(action.get("label", ""))
        self.icon_entry.set_text(action.get("icon", ""))
        self.disp_entry.set_text(action.get("dispatcher", ""))
        self.arg_entry.set_text(action.get("arg", ""))
        self.shortcut_entry.set_text(action.get("shortcut", ""))
        self.confirm_check.set_active(action.get("confirm", False))
        
        # Disable fields for separator
        is_separator = item_type == "separator"
        self.label_entry.set_sensitive(not is_separator)
        self.icon_entry.set_sensitive(not is_separator)
        self.disp_entry.set_sensitive(not is_separator and item_type == "action")
        self.arg_entry.set_sensitive(not is_separator and item_type == "action")
        self.shortcut_entry.set_sensitive(not is_separator)
        self.confirm_check.set_sensitive(not is_separator and item_type == "action")
    
    def on_type_changed(self, combo):
        item_type = combo.get_active_id()
        is_separator = item_type == "separator"
        self.label_entry.set_sensitive(not is_separator)
        self.icon_entry.set_sensitive(not is_separator)
        self.disp_entry.set_sensitive(not is_separator and item_type == "action")
        self.arg_entry.set_sensitive(not is_separator and item_type == "action")
        self.shortcut_entry.set_sensitive(not is_separator)
        self.confirm_check.set_sensitive(not is_separator and item_type == "action")
    
    def on_field_changed(self, widget):
        self.modified = True
        self.status_label.set_text("Unsaved changes")
    
    def on_modified(self, widget, param=None):
        self.modified = True
        self.status_label.set_text("Unsaved changes")
    
    def on_apply_editor(self, btn):
        selection = self.action_tree.get_selection()
        model, treeiter = selection.get_selected()
        if treeiter is None:
            self.status_label.set_text("No item selected")
            return
        
        index = model.get_path(treeiter).get_indices()[0]
        actions = self.config.get("actions", [])
        if index >= len(actions):
            return
        
        item_type = self.type_combo.get_active_id() or "action"
        
        if item_type == "separator":
            new_action = {"type": "separator"}
        elif item_type in ("submenu_workspaces", "submenu_monitors"):
            new_action = {
                "type": item_type,
                "label": self.label_entry.get_text(),
                "icon": self.icon_entry.get_text(),
                "shortcut": self.shortcut_entry.get_text()
            }
        else:
            new_action = {
                "label": self.label_entry.get_text(),
                "icon": self.icon_entry.get_text(),
                "dispatcher": self.disp_entry.get_text(),
                "arg": self.arg_entry.get_text(),
                "shortcut": self.shortcut_entry.get_text(),
                "confirm": self.confirm_check.get_active()
            }
        
        actions[index] = new_action
        self.refresh_action_list()
        # Reselect
        self.action_tree.set_cursor(Gtk.TreePath.new_from_string(str(index)))
        self.modified = True
        self.status_label.set_text("Item updated — remember to Save")
    
    def on_add_action(self, btn):
        actions = self.config.setdefault("actions", [])
        actions.append({
            "label": "New Action",
            "icon": "",
            "dispatcher": "",
            "arg": "",
            "confirm": False,
            "shortcut": ""
        })
        self.refresh_action_list()
        # Select new item
        last_idx = len(actions) - 1
        self.action_tree.set_cursor(Gtk.TreePath.new_from_string(str(last_idx)))
        self.modified = True
        self.status_label.set_text("Item added — remember to Save")
    
    def on_remove_action(self, btn):
        selection = self.action_tree.get_selection()
        model, treeiter = selection.get_selected()
        if treeiter is None:
            return
        
        index = model.get_path(treeiter).get_indices()[0]
        actions = self.config.get("actions", [])
        if index < len(actions):
            del actions[index]
            self.refresh_action_list()
            self.modified = True
            self.status_label.set_text("Item removed — remember to Save")
    
    def on_move_up(self, btn):
        selection = self.action_tree.get_selection()
        model, treeiter = selection.get_selected()
        if treeiter is None:
            return
        
        index = model.get_path(treeiter).get_indices()[0]
        actions = self.config.get("actions", [])
        if index > 0:
            actions[index - 1], actions[index] = actions[index], actions[index - 1]
            self.refresh_action_list()
            self.action_tree.set_cursor(Gtk.TreePath.new_from_string(str(index - 1)))
            self.modified = True
            self.status_label.set_text("Moved up — remember to Save")
    
    def on_move_down(self, btn):
        selection = self.action_tree.get_selection()
        model, treeiter = selection.get_selected()
        if treeiter is None:
            return
        
        index = model.get_path(treeiter).get_indices()[0]
        actions = self.config.get("actions", [])
        if index < len(actions) - 1:
            actions[index], actions[index + 1] = actions[index + 1], actions[index]
            self.refresh_action_list()
            self.action_tree.set_cursor(Gtk.TreePath.new_from_string(str(index + 1)))
            self.modified = True
            self.status_label.set_text("Moved down — remember to Save")
    
    def on_save(self, btn):
        # Update general settings
        self.config["menu"] = {
            "show_title": self.show_title_switch.get_active(),
            "title_max_length": int(self.title_len_spin.get_value()),
            "separator_before_actions": True
        }
        
        # Ensure user config dir exists
        user_dir = os.path.join(
            os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
            "hypr-windowmenu"
        )
        os.makedirs(user_dir, exist_ok=True)
        user_path = os.path.join(user_dir, "config.json")
        
        try:
            with open(user_path, "w") as f:
                json.dump(self.config, f, indent=4)
            self.config_path = user_path
            self.modified = False
            self.status_label.set_text(f"Saved to {user_path}")
        except Exception as e:
            self.status_label.set_text(f"Save failed: {e}")
    
    def on_reset_defaults(self, btn):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            flags=0,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.YES_NO,
            text="Reset to Defaults?"
        )
        dialog.format_secondary_text("This will restore the default menu configuration. Your current settings will be lost.")
        response = dialog.run()
        dialog.destroy()
        
        if response == Gtk.ResponseType.YES:
            self.config = copy.deepcopy(DEFAULT_CONFIG)
            self.show_title_switch.set_active(True)
            self.title_len_spin.set_value(40)
            self.refresh_action_list()
            self.modified = True
            self.status_label.set_text("Reset to defaults — click Save to apply")
    
    def on_close(self, widget, event):
        if self.modified:
            dialog = Gtk.MessageDialog(
                transient_for=self,
                flags=0,
                message_type=Gtk.MessageType.QUESTION,
                buttons=Gtk.ButtonsType.YES_NO,
                text="Unsaved Changes"
            )
            dialog.format_secondary_text("You have unsaved changes. Save before closing?")
            dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
            response = dialog.run()
            dialog.destroy()
            
            if response == Gtk.ResponseType.YES:
                self.on_save(None)
                return False
            elif response == Gtk.ResponseType.CANCEL:
                return True
        return False


def main():
    Gtk.init(sys.argv)
    win = SettingsWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
